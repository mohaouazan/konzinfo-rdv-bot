# Copier ce fichier en ".env" (gitignoré) et remplir :
# 1) Créer un bot Telegram via @BotFather -> token
# 2) Envoyer un message au bot, puis lire le chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
# 3) Facultatif - appel vocal Telegram (service tiers CallMeBot) pour les alertes urgentes :
#    envoie /start au bot @CallMeBot_txtbot, puis indique ton @username Telegram (ou ton numéro international).
#    Voix : fr-FR-Standard-F (femme) ou fr-FR-Standard-G (homme). CALLMEBOT_REPEAT = nombre de lectures (1 à 5).
#    Test : python -m konzinfo notify-test --call
CALLMEBOT_USER=
CALLMEBOT_LANG=fr-FR-Standard-F
CALLMEBOT_REPEAT=2
